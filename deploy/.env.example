# Copy to deploy/.env. Never put passwords in this file.
COMPOSE_PROJECT_NAME=art-alexis-production
SITE_URL=https://portfolio.example.com
ADMIN_LOGIN=siteadmin
ADMIN_EMAIL=replace@example.com
EDITOR_EMAIL=replace-editor@example.com
# Absolute path to output of npm run release (not the source wordpress folder).
RELEASE_DIR=/srv/art-alexis/dist/REPLACE_WITH_RELEASE_DIRECTORY
# Nginx on the host proxies to 127.0.0.1:BACKEND_PORT. Never expose this port.
BACKEND_PORT=8080
WORDPRESS_IMAGE=wordpress:7.1.0-php8.3-apache
MYSQL_IMAGE=mysql:8.0
CLI_IMAGE=wordpress:cli-php8.3

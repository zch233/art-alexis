# HTTP bootstrap. Replace the __TOKENS__ using tools/nginx-config.mjs.
# Install inside the nginx http context (conf.d or sites-enabled).
server {
    listen 80;
    server_name __DOMAIN__;
    if ($host != __DOMAIN__) { return 444; }
    client_max_body_size 20m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location ~ /\. { return 404; }
    location ~* ^/(wp-config\.php|xmlrpc\.php|readme\.html|license\.txt)$ { return 404; }
    location ~* /wp-content/uploads/.*\.(php[0-9]*|phtml|phar|cgi|pl|sh)(\.|$) { return 403; }
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        proxy_cache off;
    }
}

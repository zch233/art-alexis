# Use ONLY after a certificate exists. HTTP is kept for ACME renewal.
server {
    listen 80;
    server_name __DOMAIN__;
    if ($host != __DOMAIN__) { return 444; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    if ($host != __DOMAIN__) { return 444; }
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ArtAlexisTLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 20m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location ~ /\. { return 404; }
    location ~* ^/(wp-config\.php|xmlrpc\.php|readme\.html|license\.txt)$ { return 404; }
    location ~* /wp-content/uploads/.*\.(php[0-9]*|phtml|phar|cgi|pl|sh)(\.|$) { return 403; }
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        proxy_cache off;
    }
}
